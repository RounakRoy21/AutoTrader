# ─────────────────────────────────────────────────────────────────────────────
# AutoTrader — production environment template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked CHANGE_ME before running deploy.sh
# 3. NEVER commit .env to version control
#
# Hostnames use Docker Compose service names (postgres, redis).
# For local development outside Docker, override with localhost.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
PAPER_TRADING=true          # Keep true until paper-testing is complete

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autotrader
POSTGRES_USER=autotrader
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://autotrader:CHANGE_ME@postgres:5432/autotrader
DATABASE_URL_SYNC=postgresql://autotrader:CHANGE_ME@postgres:5432/autotrader

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ── Groww API ───────────────────────────────────────────────────
# Enable API access in Groww account settings, then set up a TOTP authenticator app.
# The TOTP secret is shown once during 2FA setup — save it here as the base32 string.
GROWW_CLIENT_ID=CHANGE_ME
GROWW_PASSWORD=CHANGE_ME
GROWW_TOTP_SECRET=CHANGE_ME

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_DECISION_MODEL=claude-haiku-4-5-20251001

# ── Alpha Vantage ───────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=


# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ── API Security ─────────────────────────────────────────────────────────────
# Protects trading-control endpoints (halt, resume, start, stop) from
# unauthenticated access.  Set to a strong random string (e.g. openssl rand -hex 32).
# Callers must supply this value in the X-Api-Key request header.
# Leave empty only for local development with no public network exposure.
ADMIN_API_KEY=CHANGE_ME

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For production set to your actual domain / server IP + port.
CORS_ORIGINS=http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:80

# ── Trading Configuration ───────────────────────────────────────────────────
# Capital allocation buckets (must sum to 1.0)
TOTAL_CAPITAL=1000000.0
CORE_BUCKET_PCT=0.70
HEDGE_BUCKET_PCT=0.20
WARCHEST_BUCKET_PCT=0.10

# Risk per trade
MAX_LOSS_PER_TRADE_PCT=0.015
STOP_LOSS_PCT=0.008
MIN_TARGET_PCT=0.016

# Trailing stop-loss
TRAILING_SL_ACTIVATION_PCT=0.005   # activate trail once LTP is 0.5% above entry
TRAILING_SL_TRAIL_PCT=0.005        # trail distance: keep SL 0.5% below LTP

# ATR-based SL/target multipliers
ATR_SL_MULTIPLIER=1.5              # SL = entry − ATR × multiplier
ATR_TARGET_MULTIPLIER=3.0          # target = entry + ATR × multiplier (2:1 RR)

# Intraday safeguards
GAP_FILTER_PCT=1.5                 # skip stocks that opened >1.5% above prev close
STOCK_LOCK_AFTER_SL=true           # lock a stock for the rest of the day after SL hit
CONSECUTIVE_LOSS_PAUSE_THRESHOLD=3 # pause trading after N consecutive SL hits
CONSECUTIVE_LOSS_PAUSE_MINUTES=30  # pause duration in minutes
ROI_DECAY_ENABLED=true             # gradually reduce target if price stalls

MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=6
DAILY_DRAWDOWN_LIMIT_PCT=0.03
